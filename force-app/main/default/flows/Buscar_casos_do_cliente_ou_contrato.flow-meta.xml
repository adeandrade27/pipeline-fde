        <faultConnector>
            <targetReference>Copy_1_of_Buscar_casos_do_cliente_ou_contrato</targetReference>
        </faultConnector>
        <filterLogic>1 AND 2 AND (3 OR 4 OR 5 OR 6 OR 7 OR 8)</filterLogic>
