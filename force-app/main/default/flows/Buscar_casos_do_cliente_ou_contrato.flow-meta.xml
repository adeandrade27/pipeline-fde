<?xml version="1.0" encoding="UTF-8"?>
<Flow xmlns="http://soap.sforce.com/2006/04/metadata">
    <apiVersion>66.0</apiVersion>
    <areMetricsLoggedToDataCloud>false</areMetricsLoggedToDataCloud>
    <assignments>
        <description>Adiciona o resumo do caso NBA na coleção final que será utilizada pelo Agentforce.</description>
        <name>Add_to_Collection_NBA</name>
        <label>Add to Collection NBA</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <assignmentItems>
            <assignToReference>colResumoAgent</assignToReference>
            <operator>Add</operator>
            <value>
                <elementReference>varResumo</elementReference>
            </value>
        </assignmentItems>
        <connector>
            <targetReference>Loop_NBA_Cases</targetReference>
        </connector>
    </assignments>
    <assignments>
        <description>Monta um resumo estruturado do caso NBA contendo o tipo de registro e os detalhes do campo ServiceComments__c para interpretação pelo Agentforce.</description>
        <name>Build_Agent_Summary</name>
        <label>Build Agent Summary</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <assignmentItems>
            <assignToReference>varResumo</assignToReference>
            <operator>Assign</operator>
            <value>
                <stringValue>Caso NBA identificado | Tipo: {!currentCase.RecordType.Name} | Detalhes: {!currentCase.ServiceComments__c}</stringValue>
            </value>
        </assignmentItems>
        <connector>
            <targetReference>Add_to_Collection_NBA</targetReference>
        </connector>
    </assignments>
    <assignments>
        <name>set_cases</name>
        <label>set cases</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <assignmentItems>
            <assignToReference>recordCase</assignToReference>
            <operator>Assign</operator>
            <value>
                <elementReference>Buscar_casos_do_cliente_ou_contrato</elementReference>
            </value>
        </assignmentItems>
        <connector>
            <targetReference>Loop_NBA_Cases</targetReference>
        </connector>
    </assignments>
    <assignments>
        <description>Atribui o item atual do loop à variável currentCase para simplificar o uso nos próximos elementos.</description>
        <name>Set_Current_Case</name>
        <label>Set_Current_Case</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <assignmentItems>
            <assignToReference>currentCase</assignToReference>
            <operator>Assign</operator>
            <value>
                <elementReference>Loop_NBA_Cases</elementReference>
            </value>
        </assignmentItems>
        <connector>
            <targetReference>Is_Case_NBA</targetReference>
        </connector>
    </assignments>
    <decisions>
        <description>Valida se o caso NBA possui o campo ServiceComments__c preenchido</description>
        <name>Has_ServiceComments</name>
        <label>Has_ServiceComments</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <defaultConnector>
            <targetReference>Loop_NBA_Cases</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>Não tem ServiceComments</defaultConnectorLabel>
        <rules>
            <name>Tem_ServiceComments</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>currentCase.ServiceComments__c</leftValueReference>
                <operator>NotEqualTo</operator>
            </conditions>
            <connector>
                <targetReference>Build_Agent_Summary</targetReference>
            </connector>
            <label>Tem ServiceComments</label>
        </rules>
    </decisions>
    <decisions>
        <description>Verifica se o caso pertence aos tipos NBA (retenção ou rentabilização).</description>
        <name>Is_Case_NBA</name>
        <label>Is_Case_NBA</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <defaultConnector>
            <targetReference>Loop_NBA_Cases</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>Não é NBA</defaultConnectorLabel>
        <rules>
            <name>NBA</name>
            <conditionLogic>or</conditionLogic>
            <conditions>
                <leftValueReference>currentCase.RecordType.Name</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>Claro NBA Retenção</stringValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>currentCase.RecordType.Name</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>Claro NBA Rentabilização</stringValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>currentCase.RecordType.Name</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>Claro NBA Rentab Receptivo</stringValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>currentCase.RecordType.Name</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>Claro NBA Rentab Ativo</stringValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Has_ServiceComments</targetReference>
            </connector>
            <label>Is_NBA</label>
        </rules>
    </decisions>
    <environments>Default</environments>
    <formulas>
        <description>Range de busca dos casos, até 6 meses passados.</description>
        <name>getRange</name>
        <dataType>DateTime</dataType>
        <expression>(DATETIMEVALUE({!$Flow.CurrentDate} - 180))</expression>
    </formulas>
    <interviewLabel>Buscar casos do cliente ou contrato {!$Flow.CurrentDateTime}</interviewLabel>
    <label>Buscar casos do cliente ou contrato</label>
    <loops>
        <description>Percorre todos os casos retornados para identificar casos NBA e extrair informações de troca de plano.</description>
        <name>Loop_NBA_Cases</name>
        <label>Loop NBA Cases</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <collectionReference>recordCase</collectionReference>
        <iterationOrder>Asc</iterationOrder>
        <nextValueConnector>
            <targetReference>Set_Current_Case</targetReference>
        </nextValueConnector>
    </loops>
    <processMetadataValues>
        <name>BuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>CanvasMode</name>
        <value>
            <stringValue>AUTO_LAYOUT_CANVAS</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>OriginBuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processType>AutoLaunchedFlow</processType>
    <recordLookups>
