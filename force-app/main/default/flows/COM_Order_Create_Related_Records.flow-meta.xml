    <decisions>
        <description>Does the pricebook field on the order have a value ?</description>
        <name>Is_Pricebook_Populated</name>
        <label>Is Pricebook Populated</label>
        <locationX>182</locationX>
        <locationY>947</locationY>
        <defaultConnectorLabel>Default Outcome</defaultConnectorLabel>
        <rules>
            <name>Pricebook_Not_Set</name>
            <conditionLogic>or</conditionLogic>
            <conditions>
                <leftValueReference>$Record.Pricebook2Id</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.Pricebook2Id</leftValueReference>
                <operator>IsBlank</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Query_for_Std_Pricebook_Id</targetReference>
            </connector>
            <label>Pricebook Not Set</label>
        </rules>
    </decisions>
    <decisions>
        <description>Is the order generated from a quote.  Is the QuoteId field populated.</description>
        <name>Order_From_Quote</name>
        <label>Order From Quote ?</label>
        <locationX>182</locationX>
        <locationY>323</locationY>
        <defaultConnector>
            <targetReference>Get_Account_Details</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>From Quote</defaultConnectorLabel>
        <rules>
            <name>Not_From_Quote</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>$Record.QuoteId</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Create_App_Assignment_Record</targetReference>
            </connector>
            <label>Not From Quote</label>
        </rules>
    </decisions>
