    <recordLookups>
        <description>Gets the individual asset action records with an asset ID that matches the ID of the asset passed into the flow. Stores the ID of the results in the Asset Actions from GetAssetActions record collection.</description>
        <name>GetAssetActions</name>
        <label>Get Asset Actions</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <assignNullValuesIfNoRecordsFound>false</assignNullValuesIfNoRecordsFound>
        <connector>
            <targetReference>HaveAssetActionsRecords</targetReference>
        </connector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>AssetId</field>
            <operator>In</operator>
            <value>
                <elementReference>AssetIds</elementReference>
            </value>
        </filters>
        <getFirstRecordOnly>false</getFirstRecordOnly>
        <object>AssetAction</object>
        <queriedFields>Id</queriedFields>
        <storeOutputAutomatically>true</storeOutputAutomatically>
    </recordLookups>
    <recordLookups>
        <description>Gets the individual asset action source records with an asset action ID that matches the ID of the asset action passed into the flow. Stores the results in the Asset Action Sources from GetAssetActionSources record collection.</description>
        <name>GetAssetActionSources</name>
        <label>Get Asset Action Sources</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <assignNullValuesIfNoRecordsFound>false</assignNullValuesIfNoRecordsFound>
        <connector>
            <targetReference>HaveAssetActionsSourceRecords</targetReference>
        </connector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>AssetActionId</field>
            <operator>In</operator>
            <value>
                <elementReference>assetActionIds</elementReference>
            </value>
        </filters>
        <getFirstRecordOnly>false</getFirstRecordOnly>
        <object>AssetActionSource</object>
        <storeOutputAutomatically>true</storeOutputAutomatically>
    </recordLookups>
    <recordLookups>
        <description>Gets the individual fulfillment line source relationship records with a order product ID that’s part of the source item identifier passed into the flow and with a fulfillment order product ID. Stores the results in the Fulfillment Line Source Relationships from GetFulfillmentLineSourceRelationships record collection.</description>
        <name>GetFulfillmentLineSourceRelationships</name>
        <label>Get Fulfillment Line Source Relationships</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <assignNullValuesIfNoRecordsFound>false</assignNullValuesIfNoRecordsFound>
        <connector>
            <targetReference>HaveFulfillmentLineSourceRelationshipRecords</targetReference>
        </connector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>SourceItemIdentifier</field>
            <operator>In</operator>
            <value>
                <elementReference>OrderProductIds</elementReference>
            </value>
        </filters>
        <filters>
            <field>FulfilmentOrderLineId</field>
            <operator>IsNull</operator>
            <value>
                <booleanValue>false</booleanValue>
            </value>
        </filters>
        <getFirstRecordOnly>false</getFirstRecordOnly>
        <object>FulfillmentLineSourceRel</object>
        <storeOutputAutomatically>true</storeOutputAutomatically>
    </recordLookups>
    <recordLookups>
        <description>Gets the individual fulfillment step source records with a order product ID that’s part of the source identifier passed into the flow or with a fullfilment order line ID that’s part of the source identifier passed into the flow. Stores the ID of the results in the Fulfillment Step Sources from GetFulfillmentStepSources record collection.</description>
        <name>GetFulfillmentStepSources</name>
        <label>Get Fulfillment Step Sources</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <assignNullValuesIfNoRecordsFound>false</assignNullValuesIfNoRecordsFound>
        <connector>
            <targetReference>HaveFulfillmentStepSourceRecords</targetReference>
        </connector>
        <filterLogic>or</filterLogic>
        <filters>
            <field>SourceIdentifier</field>
            <operator>In</operator>
            <value>
                <elementReference>OrderProductIds</elementReference>
            </value>
        </filters>
        <filters>
            <field>SourceIdentifier</field>
            <operator>In</operator>
            <value>
                <elementReference>FulfillmentOrderLineIds</elementReference>
            </value>
        </filters>
        <getFirstRecordOnly>false</getFirstRecordOnly>
        <object>FulfillmentStepSource</object>
        <queriedFields>Id</queriedFields>
        <queriedFields>StepId</queriedFields>
        <storeOutputAutomatically>true</storeOutputAutomatically>
    </recordLookups>
    <recordLookups>
        <description>Gets the fulfillment steps with fulfillment step IDs that are part of the FulfillmentStepIds collection variable and with a State equal to Pending, Ready, In Progress, Failed, Fatally Failed, or Scheduled. Stores the results in the Fulfillment Steps from GetIncompleteFulfillmentSteps record collection.</description>
        <name>GetIncompleteFulfillmentSteps</name>
        <label>Get Incomplete Fulfillment Steps</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <assignNullValuesIfNoRecordsFound>false</assignNullValuesIfNoRecordsFound>
        <connector>
            <targetReference>SetIncompleteFulfillmentStep</targetReference>
        </connector>
        <filterLogic>1 AND (2 OR 3 OR 4 OR 5 OR 6 OR 7)</filterLogic>
        <filters>
            <field>Id</field>
            <operator>In</operator>
            <value>
                <elementReference>FulfillmentStepIds</elementReference>
            </value>
        </filters>
        <filters>
            <field>State</field>
            <operator>EqualTo</operator>
            <value>
                <stringValue>Pending</stringValue>
            </value>
        </filters>
        <filters>
            <field>State</field>
            <operator>EqualTo</operator>
            <value>
                <stringValue>Ready</stringValue>
            </value>
        </filters>
        <filters>
            <field>State</field>
            <operator>EqualTo</operator>
            <value>
                <stringValue>InProgress</stringValue>
            </value>
        </filters>
        <filters>
            <field>State</field>
            <operator>EqualTo</operator>
            <value>
                <stringValue>Failed</stringValue>
            </value>
        </filters>
        <filters>
            <field>State</field>
            <operator>EqualTo</operator>
            <value>
                <stringValue>FatallyFailed</stringValue>
            </value>
        </filters>
        <filters>
            <field>State</field>
            <operator>EqualTo</operator>
            <value>
                <stringValue>Scheduled</stringValue>
            </value>
        </filters>
        <getFirstRecordOnly>false</getFirstRecordOnly>
        <object>FulfillmentStep</object>
        <storeOutputAutomatically>true</storeOutputAutomatically>
    </recordLookups>
    <recordLookups>
        <description>Gets the individual order action records with an order ID that matches the ID of the order passed into the flow and with an asset ID. Stores the results in the Order Actions from GetOrderActions record collection.</description>
        <name>GetOrderActions</name>
        <label>Get Order Actions</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <assignNullValuesIfNoRecordsFound>false</assignNullValuesIfNoRecordsFound>
        <connector>
            <targetReference>HaveOrderActionsRecords</targetReference>
        </connector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>OrderId</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>orderId</elementReference>
            </value>
        </filters>
        <filters>
            <field>SourceAssetId</field>
            <operator>IsNull</operator>
            <value>
                <booleanValue>false</booleanValue>
            </value>
        </filters>
        <getFirstRecordOnly>false</getFirstRecordOnly>
        <object>OrderAction</object>
        <storeOutputAutomatically>true</storeOutputAutomatically>
    </recordLookups>
