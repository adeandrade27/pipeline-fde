<?xml version="1.0" encoding="UTF-8"?>
<Flow xmlns="http://soap.sforce.com/2006/04/metadata">
    <actionCalls>
        <description>Calls an action that submits the order associated with the order ID passed in the flow.</description>
        <name>SubmitOrderAction</name>
        <label>Submit Order</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <actionName>submitOrder</actionName>
        <actionType>submitOrder</actionType>
        <connector>
            <targetReference>SetSubmitOrderToTrue</targetReference>
        </connector>
        <faultConnector>
            <targetReference>ScreenDisplayErrorSubmitOrder</targetReference>
        </faultConnector>
        <flowTransactionModel>CurrentTransaction</flowTransactionModel>
        <inputParameters>
            <name>orderId</name>
            <value>
                <elementReference>orderId</elementReference>
            </value>
        </inputParameters>
        <nameSegment>submitOrder</nameSegment>
        <offset>0</offset>
        <storeOutputAutomatically>true</storeOutputAutomatically>
    </actionCalls>
    <apiVersion>65.0</apiVersion>
    <areMetricsLoggedToDataCloud>false</areMetricsLoggedToDataCloud>
    <assignments>
        <description>Adds the ID of the current individual fulfillment step record in the loop to the IncompleteFulfillmentStepsToDiscard collection.</description>
        <name>AddIncompleteFulfillmentStepsToIdsToCollection</name>
        <label>Add Incomplete Fulfillment Step IDs to Collection</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <assignmentItems>
            <assignToReference>IncompleteFulfillmentStepIdsToDiscard</assignToReference>
            <operator>Add</operator>
            <value>
                <elementReference>IterateOverSelectedIncompleteFulfillmentSteps.UniqueField__Id</elementReference>
            </value>
        </assignmentItems>
        <connector>
            <targetReference>IterateOverSelectedIncompleteFulfillmentSteps</targetReference>
        </connector>
    </assignments>
    <assignments>
        <description>Sets areIncompleteFulfillmentStepsFound to true to indicate that no incomplete fulfillment steps are found in the order related to the order ID passed in the flow.</description>
        <name>SetIncompleteFulfillmentStepsFound</name>
        <label>Set Incomplete Fulfillment Steps Found</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <assignmentItems>
            <assignToReference>AreIncompleteFulfillmentStepsFound</assignToReference>
            <operator>Assign</operator>
            <value>
                <booleanValue>true</booleanValue>
            </value>
        </assignmentItems>
        <connector>
            <targetReference>ShouldDiscardIncompleteFulfillmentSteps</targetReference>
        </connector>
    </assignments>
    <assignments>
        <description>Sets IsOrderSubmitted to False to indicate that the order submission has failed.</description>
        <name>SetSubmitOrderToFalse</name>
        <label>Set Submit Order to False</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <assignmentItems>
            <assignToReference>IsOrderSubmitted</assignToReference>
            <operator>Assign</operator>
            <value>
                <booleanValue>false</booleanValue>
            </value>
        </assignmentItems>
        <connector>
            <targetReference>ScreenDisplaySuccessSubmitOrder</targetReference>
        </connector>
    </assignments>
    <assignments>
        <description>Sets IsOrderSubmitted to True to indicate that the order is submitted.</description>
        <name>SetSubmitOrderToTrue</name>
        <label>Set Submit Order to True</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <assignmentItems>
            <assignToReference>IsOrderSubmitted</assignToReference>
            <operator>Assign</operator>
            <value>
                <booleanValue>true</booleanValue>
            </value>
        </assignmentItems>
        <connector>
            <targetReference>ScreenDisplaySuccessSubmitOrder</targetReference>
        </connector>
    </assignments>
    <choices>
        <description>Stores the choice label and value for the Discard incomplete fulfillment steps option for SubmitOrderRadioButtons on the ScreenDisplayIncompleteFulfillmentSteps screen.</description>
        <name>ChoiceSubmitOrderDiscardIncompleteFulfillmentStep</name>
        <choiceText>Discard incomplete fulfillment steps</choiceText>
        <dataType>Number</dataType>
        <value>
            <numberValue>1.0</numberValue>
        </value>
    </choices>
    <choices>
        <description>Stores the choice label and value for the Exit option for SubmitOrderRadioButtons on the ScreenDisplayIncompleteFulfillmentSteps screen.</description>
        <name>ChoiceSubmitOrderExit</name>
        <choiceText>Exit</choiceText>
        <dataType>Number</dataType>
        <value>
            <numberValue>3.0</numberValue>
        </value>
    </choices>
    <choices>
        <description>Stores the choice label and value for the Submit order with incomplete steps option for SubmitOrderRadioButtons on the ScreenDisplayIncompleteFulfillmentSteps screen.</description>
        <name>ChoiceSubmitOrderWithIncompleteSteps</name>
        <choiceText>Submit order with incomplete steps</choiceText>
        <dataType>Number</dataType>
        <value>
            <numberValue>2.0</numberValue>
        </value>
    </choices>
    <decisions>
        <description>Determines whether incomplete fulfillment steps were found by checking if the IncompleteFulfillmentSteps record collection contains a record.</description>
        <name>HaveIncompleteFulfillmentSteps</name>
        <label>Have Incomplete Fulfillment Steps?</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <defaultConnector>
            <targetReference>SetIncompleteFulfillmentStepsFound</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>No</defaultConnectorLabel>
        <rules>
            <name>HaveFulfillmentStepSourceRecords</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>IncompleteFulfillmentSteps</leftValueReference>
                <operator>IsEmpty</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>IncompleteFulfillmentSteps</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>ScreenDisplayIncompleteFulfillmentSteps</targetReference>
            </connector>
            <label>Yes</label>
        </rules>
    </decisions>
    <decisions>
        <description>Determines whether to discard the incomplete fulfillment steps and then submit the order by checking if the flow user chose the Discard incomplete fulfillment steps option on the ScreenDisplayIncompleteFulfillmentSteps screen.</description>
        <name>ShouldDiscardIncompleteFulfillmentSteps</name>
        <label>Should Discard Incomplete Fulfillment Steps?</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <defaultConnector>
            <targetReference>ShouldSubmitOrder</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>No</defaultConnectorLabel>
        <rules>
            <name>DiscardIncompleteFulfillmentSteps</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>SubmitOrderRadioButtons</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <numberValue>1.0</numberValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>IncompleteStepsDisplayTextContainer.AllItems</leftValueReference>
                <operator>IsEmpty</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>IterateOverSelectedIncompleteFulfillmentSteps</targetReference>
            </connector>
            <label>Yes</label>
        </rules>
    </decisions>
    <decisions>
        <description>Determines whether to submit the order by checking if there are no incomplete steps found, the flow user chose Discard incomplete fulfillment steps, or the flow user chose the Submit order with incomplete steps option on the ScreenDisplayIncompleteFulfillmentSteps screen.</description>
        <name>ShouldSubmitOrder</name>
        <label>Should Submit Order?</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <defaultConnector>
            <targetReference>SetSubmitOrderToFalse</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>No</defaultConnectorLabel>
        <rules>
            <name>SubmitOrder</name>
            <conditionLogic>or</conditionLogic>
            <conditions>
                <leftValueReference>AreIncompleteFulfillmentStepsFound</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>SubmitOrderRadioButtons</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <numberValue>1.0</numberValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>SubmitOrderRadioButtons</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <numberValue>2.0</numberValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>SubmitOrderAction</targetReference>
            </connector>
            <label>Yes</label>
        </rules>
    </decisions>
    <environments>Default</environments>
    <interviewLabel>SubmitOrderTest1 {!$Flow.CurrentDateTime}</interviewLabel>
    <label>SubmitOrderTest1</label>
    <loops>
        <description>Repeats an action for each incomplete fulfillment step record selected in the ScreenDisplayIncompleteFulfillmentSteps screen.</description>
        <name>IterateOverSelectedIncompleteFulfillmentSteps</name>
        <label>Iterate Over Selected Incomplete Fulfillment Steps</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <collectionReference>IncompleteStepsDisplayTextContainer.AllItems</collectionReference>
        <iterationOrder>Asc</iterationOrder>
        <nextValueConnector>
            <targetReference>AddIncompleteFulfillmentStepsToIdsToCollection</targetReference>
        </nextValueConnector>
        <noMoreValuesConnector>
            <targetReference>UpdateFulfillmentSteps</targetReference>
        </noMoreValuesConnector>
    </loops>
    <processMetadataValues>
        <name>BuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>CanvasMode</name>
        <value>
            <stringValue>AUTO_LAYOUT_CANVAS</stringValue>
        </value>
    </processMetadataValues>
    <processType>Flow</processType>
    <recordUpdates>
        <description>Updates the fulfillment step record with an ID that’s part of the IncompleteFulfillmentStepsToDiscard collection. Sets the State field to Discarded and the Execution Message field to a message that states that the step is discarded.</description>
        <name>UpdateFulfillmentSteps</name>
        <label>Update Fulfillment Steps</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <connector>
            <targetReference>ShouldSubmitOrder</targetReference>
        </connector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>Id</field>
            <operator>In</operator>
            <value>
                <elementReference>IncompleteFulfillmentStepIdsToDiscard</elementReference>
            </value>
        </filters>
        <inputAssignments>
            <field>ExecutionMessage</field>
            <value>
                <stringValue>Step is discarded from flow</stringValue>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>State</field>
            <value>
                <stringValue>Discarded</stringValue>
            </value>
        </inputAssignments>
        <object>FulfillmentStep</object>
    </recordUpdates>
    <screens>
        <description>Displays an error to the flow user when there&apos;s an error submitting an order.</description>
        <name>ScreenDisplayErrorSubmitOrder</name>
        <label>Display Error</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <allowBack>true</allowBack>
        <allowFinish>true</allowFinish>
        <allowPause>true</allowPause>
        <fields>
            <name>ErrorDisplayText</name>
            <fieldText>&lt;p&gt;&lt;span style=&quot;color: rgb(68, 68, 68); background-color: rgb(255, 255, 255);&quot;&gt;{!$Flow.FaultMessage}&lt;/span&gt;&lt;/p&gt;&lt;p&gt;&lt;br&gt;&lt;/p&gt;&lt;p&gt;{!SubmitOrderAction.errorCode}&lt;/p&gt;</fieldText>
            <fieldType>DisplayText</fieldType>
        </fields>
        <showFooter>true</showFooter>
        <showHeader>true</showHeader>
    </screens>
    <screens>
        <description>Allows flow user to review the list of incomplete fulfillment steps retrieved by using the order ID passed into the flow, and then  select an option to submit the order with or without discarding the incomplete steps.</description>
        <name>ScreenDisplayIncompleteFulfillmentSteps</name>
        <label>Display Incomplete Fulfillment Steps</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <allowBack>true</allowBack>
        <allowFinish>true</allowFinish>
        <allowPause>true</allowPause>
        <connector>
            <targetReference>ShouldDiscardIncompleteFulfillmentSteps</targetReference>
        </connector>
        <fields>
            <name>IncompleteStepsScreenHeading</name>
            <fieldText>&lt;p&gt;Review the incomplete fulfillment steps and remove the steps that you don’t want to discard.&lt;/p&gt;</fieldText>
            <fieldType>DisplayText</fieldType>
        </fields>
        <fields>
            <name>IncompleteStepsDisplayTextContainer</name>
            <fieldType>Repeater</fieldType>
            <fields>
                <name>IncompleteStepsDisplayText</name>
                <fieldText>&lt;p&gt;&lt;strong&gt;Name&lt;/strong&gt;: {!IncompleteFulfillmentSteps[$EachItem].Name}&lt;/p&gt;&lt;p&gt;&lt;strong&gt;StepType&lt;/strong&gt;: {!IncompleteFulfillmentSteps[$EachItem].StepType}&lt;/p&gt;&lt;p&gt;&lt;strong&gt;State&lt;/strong&gt;: {!IncompleteFulfillmentSteps[$EachItem].State}&lt;/p&gt;&lt;p&gt;&lt;strong&gt;Step Id&lt;/strong&gt;: {!IncompleteFulfillmentSteps[$EachItem].Id}&lt;/p&gt;&lt;p&gt;&lt;strong&gt;Plan Id&lt;/strong&gt;: {!IncompleteFulfillmentSteps[$EachItem].FulfillmentPlanId}&lt;/p&gt;</fieldText>
                <fieldType>DisplayText</fieldType>
            </fields>
            <inputParameters>
                <name>collection</name>
                <value>
                    <elementReference>IncompleteFulfillmentSteps</elementReference>
                </value>
            </inputParameters>
            <inputParameters>
                <name>canAddItem</name>
                <value>
                    <booleanValue>false</booleanValue>
                </value>
            </inputParameters>
            <inputParameters>
                <name>canRemoveItem</name>
                <value>
                    <booleanValue>true</booleanValue>
                </value>
            </inputParameters>
            <isRequired>false</isRequired>
        </fields>
        <fields>
            <name>SubmitOrderRadioButtons</name>
            <choiceReferences>ChoiceSubmitOrderDiscardIncompleteFulfillmentStep</choiceReferences>
            <choiceReferences>ChoiceSubmitOrderWithIncompleteSteps</choiceReferences>
            <choiceReferences>ChoiceSubmitOrderExit</choiceReferences>
            <dataType>Number</dataType>
            <fieldText>Choose an action:</fieldText>
            <fieldType>RadioButtons</fieldType>
            <inputsOnNextNavToAssocScrn>UseStoredValues</inputsOnNextNavToAssocScrn>
            <isRequired>true</isRequired>
            <scale>0</scale>
        </fields>
        <showFooter>true</showFooter>
        <showHeader>true</showHeader>
    </screens>
    <screens>
        <description>Displays a successful message to the flow user when the incomplete steps are discarded, order is submitted, or the flow user exits the flow without making a choice.</description>
        <name>ScreenDisplaySuccessSubmitOrder</name>
        <label>Display Success</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <allowBack>true</allowBack>
        <allowFinish>true</allowFinish>
        <allowPause>true</allowPause>
        <fields>
            <name>StepsDiscardedDisplayText</name>
            <fieldText>&lt;p&gt;Incomplete fulfillment steps are discarded.&lt;/p&gt;</fieldText>
            <fieldType>DisplayText</fieldType>
            <visibilityRule>
                <conditionLogic>and</conditionLogic>
                <conditions>
                    <leftValueReference>IncompleteFulfillmentStepIdsToDiscard</leftValueReference>
                    <operator>IsNull</operator>
                    <rightValue>
                        <booleanValue>false</booleanValue>
                    </rightValue>
                </conditions>
            </visibilityRule>
        </fields>
        <fields>
            <name>OrderSubmittedDisplayText</name>
            <fieldText>&lt;p&gt;Order {!orderId} was submitted.&lt;/p&gt;</fieldText>
            <fieldType>DisplayText</fieldType>
            <visibilityRule>
                <conditionLogic>and</conditionLogic>
                <conditions>
                    <leftValueReference>IsOrderSubmitted</leftValueReference>
                    <operator>EqualTo</operator>
                    <rightValue>
                        <booleanValue>true</booleanValue>
                    </rightValue>
                </conditions>
            </visibilityRule>
        </fields>
        <fields>
            <name>ExitDisplayText</name>
            <fieldText>&lt;p&gt;Exited without discarding incomplete fulfillment steps and without submitting the order.&lt;/p&gt;</fieldText>
            <fieldType>DisplayText</fieldType>
            <visibilityRule>
                <conditionLogic>and</conditionLogic>
                <conditions>
                    <leftValueReference>IsOrderSubmitted</leftValueReference>
                    <operator>EqualTo</operator>
                    <rightValue>
                        <booleanValue>false</booleanValue>
                    </rightValue>
                </conditions>
                <conditions>
                    <leftValueReference>IncompleteFulfillmentStepIdsToDiscard</leftValueReference>
                    <operator>IsNull</operator>
                    <rightValue>
                        <booleanValue>true</booleanValue>
                    </rightValue>
                </conditions>
            </visibilityRule>
        </fields>
        <showFooter>true</showFooter>
        <showHeader>true</showHeader>
    </screens>
    <sourceTemplate>revenue_dro__SubmitOrderWithValidation</sourceTemplate>
    <start>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <connector>
            <targetReference>Get_Steps_from_Order_Test</targetReference>
        </connector>
    </start>
    <status>Active</status>
    <subflows>
        <name>Get_Steps_from_Order_Test</name>
        <label>Get Steps from Order Test</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <connector>
            <targetReference>HaveIncompleteFulfillmentSteps</targetReference>
        </connector>
        <flowName>Get_Steps_From_Order_Test1</flowName>
        <inputAssignments>
            <name>orderId</name>
            <value>
                <elementReference>orderId</elementReference>
            </value>
        </inputAssignments>
        <outputAssignments>
            <assignToReference>IncompleteFulfillmentSteps</assignToReference>
            <name>incompleteFulfillmentSteps</name>
        </outputAssignments>
    </subflows>
    <variables>
        <description>Stores a boolean value that indicates whether incomplete fulfillment steps are found.</description>
        <name>AreIncompleteFulfillmentStepsFound</name>
        <dataType>Boolean</dataType>
        <isCollection>false</isCollection>
        <isInput>false</isInput>
        <isOutput>false</isOutput>
    </variables>
    <variables>
        <description>Stores the IDs of the incomplete fulfillment steps that the flow user has selected to discard.</description>
        <name>IncompleteFulfillmentStepIdsToDiscard</name>
        <dataType>String</dataType>
        <isCollection>true</isCollection>
        <isInput>false</isInput>
        <isOutput>false</isOutput>
    </variables>
    <variables>
        <description>Stores the IDs of incomplete fulfillment step records from the order related to the order ID passed in the flow.</description>
        <name>IncompleteFulfillmentSteps</name>
        <dataType>SObject</dataType>
        <isCollection>true</isCollection>
        <isInput>false</isInput>
        <isOutput>false</isOutput>
        <objectType>FulfillmentStep</objectType>
    </variables>
    <variables>
        <description>Stores a boolean value that indicates whether the order was submitted.</description>
        <name>IsOrderSubmitted</name>
        <dataType>Boolean</dataType>
        <isCollection>false</isCollection>
        <isInput>false</isInput>
        <isOutput>false</isOutput>
    </variables>
    <variables>
        <description>Stores the ID of the order passed into the flow.</description>
        <name>orderId</name>
        <dataType>String</dataType>
        <isCollection>false</isCollection>
        <isInput>true</isInput>
        <isOutput>false</isOutput>
    </variables>
</Flow>
